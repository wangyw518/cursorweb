# ===== 浏览器预览：可不填 =====
VITE_APP_NAME=摸鱼判官

# ===== 微信小游戏（上线必填）=====
# 微信公众平台 -> 开发管理 -> 开发设置
VITE_WECHAT_APP_ID=wxc8683bd9c1599d7d

# 激励视频广告位（流量主开通后创建）
VITE_REWARD_AD_UNIT_ID=adunit-xxxxxxxxxxxxxxxx

# 分享卡片图（建议 500x400，放到 CDN 或小游戏包内）
# 本地默认用 public/share-cover.png；正式环境建议换成 CDN HTTPS 地址
VITE_SHARE_IMAGE_URL=/share-cover.png

# ===== 可选：云排行榜 / 群维度榜 =====
# 若使用微信云开发，填环境 ID；没有则本地榜 + 分享种子仍可病毒传播
VITE_CLOUD_ENV_ID=

# 可选自建后端（仅排行榜/反作弊，玩法不依赖）
VITE_API_BASE_URL=
